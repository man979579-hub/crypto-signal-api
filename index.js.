
import express from "express";

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    name: "Crypto Signal API",
    status: "online",
    message: "API berhasil dijalankan",
    endpoints: ["/api/health", "/api/signal?symbol=BTCUSDT"]
  });
});

app.get("/api/health", (req, res) => {
  res.json({
    status: "ok",
    timestamp: new Date().toISOString()
  });
});

app.get("/api/signal", async (req, res) => {
  const symbol = String(req.query.symbol || "BTCUSDT").toUpperCase();

  if (!/^[A-Z0-9]{5,20}$/.test(symbol)) {
    return res.status(400).json({
      error: "Simbol crypto tidak valid"
    });
  }

  try {
    const response = await fetch(
      `https://api.binance.com/api/v3/klines?symbol=${encodeURIComponent(symbol)}&interval=1h&limit=50`
    );

    if (!response.ok) {
      return res.status(502).json({
        error: "Sumber data crypto sedang tidak tersedia"
      });
    }

    const candles = await response.json();

    if (!Array.isArray(candles) || candles.length < 20) {
      return res.status(502).json({
        error: "Data historis tidak mencukupi"
      });
    }

    const closes = candles.map(c => Number(c[4]));
    const last = closes[closes.length - 1];

    const sma = (arr, n) =>
      arr.slice(-n).reduce((sum, v) => sum + v, 0) / n;

    const sma10 = sma(closes, 10);
    const sma20 = sma(closes, 20);

    let signal = "HOLD";

    if (last > sma10 && sma10 > sma20) {
      signal = "BUY";
    } else if (last < sma10 && sma10 < sma20) {
      signal = "SELL";
    }

    res.json({
      symbol,
      interval: "1h",
      price: last,
      sma10: Number(sma10.toFixed(6)),
      sma20: Number(sma20.toFixed(6)),
      signal,
      strategy: "SMA 10/20 trend",
      warning: "Sinyal berbasis indikator sederhana, bukan jaminan profit.",
      updatedAt: new Date().toISOString()
    });
  } catch (error) {
    res.status(502).json({
      error: "Gagal mengambil data pasar",
      message: "Periksa koneksi atau ketersediaan Binance API."
    });
  }
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`Crypto Signal API berjalan pada port ${PORT}`);
});
